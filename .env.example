# Copy this file to ".env" and fill in the values.
# The app loads .env automatically (python-dotenv) — no shell setup needed.
# NEVER commit the real .env (the included .gitignore prevents this).

# Neon Postgres for THIS app. Neon dashboard -> Connect -> connection pooling OFF ->
# copy the connection string.
#
# IMPORTANT: this must be the CHRO Recognition project — NOT the A&D workbench's and NOT
# the S&P 200 App's. `run.py` prints the host on every run so you can see which one it used.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Password for the hosted dashboard. Leave EMPTY locally (no login screen).
# On Streamlit Community Cloud set it in the app's Secrets box instead.
APP_PASSWORD=

# Anthropic API key. Needed ONLY by the research steps (roles / companies / accomplishments).
# Seeding from the workbook and the dashboard run without it.
ANTHROPIC_API_KEY=
